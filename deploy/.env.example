# === Kikost Cafe POS — environment produksi ===
# Salin ke /opt/apps/cafe-pos/.env di VPS dan isi nilai asli.
# JANGAN commit file .env yang sudah terisi.

# ---- Domain & reverse proxy ----
POS_DOMAIN=pos.kikost.com
# Nama docker network milik reverse proxy yang SUDAH ADA di VPS.
# Cek dengan: docker network ls
PROXY_NETWORK=proxy
# certresolver yang dikonfigurasi di Traefik yang sudah ada (Let's Encrypt).
TRAEFIK_CERTRESOLVER=letsencrypt

# ---- PostgreSQL POS (WAJIB terpisah dari database lain di VPS) ----
POSTGRES_USER=cafe_pos
POSTGRES_PASSWORD=GANTI_dengan_openssl_rand_hex_24
POSTGRES_DB=cafe_pos

# Tuning PostgreSQL untuk VPS bersama (KVM 4 = 4 vCPU / 16 GB; POS pakai porsi kecil).
PG_MAX_CONNECTIONS=50
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=384MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=64MB

# ---- API ----
# Kunci perangkat sinkronisasi (dipisahkan koma). Buat: openssl rand -hex 32
SYNC_DEVICE_KEYS=GANTI_kunci_perangkat_1
CORS_ORIGINS=https://pos.kikost.com
PGPOOL_MAX=10
RATE_LIMIT_MAX=240
LOG_LEVEL=info
RUN_MIGRATIONS_ON_BOOT=true

# ---- Batas resource (agar tidak mengganggu kikost.com) ----
PG_CPU_LIMIT=1.0
PG_MEM_LIMIT=512M
API_CPU_LIMIT=1.0
API_MEM_LIMIT=384M
WEB_CPU_LIMIT=0.5
WEB_MEM_LIMIT=128M

# ---- Backup ----
# Cron dalam waktu VPS (biasanya UTC). 15 18 * * * = 01:15 WIB.
BACKUP_CRON=15 18 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_ON_START=false
# Opsional: perintah unggah off-site, menerima path arsip sebagai $1. Contoh rclone:
# BACKUP_OFFSITE_CMD=rclone copy "$1" remote:cafe-pos-backups

# ---- Image (isi bila memakai registry, mis. GHCR, alih-alih build di VPS) ----
# API_IMAGE=ghcr.io/OWNER/cafe-pos-api:TAG
# WEB_IMAGE=ghcr.io/OWNER/cafe-pos-web:TAG
