# Salin file ini menjadi .env sebelum menjalankan aplikasi web.
# Jangan pernah menyimpan nilai asli/secret di dalam source control.

# URL dasar backend API Kikost Cafe POS.
# Kosong = same-origin: aplikasi memanggil "/api/..." pada domain yang sama
# (reverse proxy meneruskan /api ke container cafe-pos-api). Ini nilai yang
# dipakai untuk produksi di https://pos.kikost.com.
# Untuk pengembangan lokal dengan backend di port lain, isi mis.:
#   VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=

# Kunci perangkat untuk autentikasi sinkronisasi ke backend.
# Untuk produksi, kunci dibuat administrator (openssl rand -hex 32) dan
# dimasukkan lewat menu Pengaturan > Sinkronisasi pada tablet, ATAU disuntik
# saat build. Nilai di sini hanya untuk pengembangan lokal.
VITE_DEVICE_SYNC_KEY=

# Label build/debug. Identitas kafe sebenarnya diatur lewat onboarding di aplikasi.
VITE_BUILD_LABEL=kikost-cafe-pos
