# Salin menjadi backend/.env untuk pengembangan lokal.
# JANGAN commit file .env yang berisi nilai asli.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# Koneksi PostgreSQL POS (database TERPISAH dari database lain di VPS).
DATABASE_URL=postgres://cafe_pos:CHANGE_ME@localhost:5432/cafe_pos

# Pool koneksi
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=10000

# Kunci perangkat yang sah untuk sinkronisasi (dipisahkan koma).
# Buat dengan: openssl rand -hex 32
# Untuk produksi WAJIB diisi minimal satu.
SYNC_DEVICE_KEYS=

# Origin yang diizinkan CORS (dipisahkan koma). Contoh: https://pos.kikost.com
CORS_ORIGINS=

# Batas laju permintaan per menit per IP (health dikecualikan).
RATE_LIMIT_MAX=240

# Batas ukuran sinkronisasi
SYNC_MAX_BATCH=200
SYNC_PULL_LIMIT=500

LOG_LEVEL=info

# Jalankan migrasi saat boot container (aman: additif + advisory lock). Set 'false' untuk menonaktifkan.
RUN_MIGRATIONS_ON_BOOT=true

ENABLE_BACKUP_ENDPOINT=false
